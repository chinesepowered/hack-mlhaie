<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=1920, height=1080" />
<title>CapyWorks demo video</title>
<script src="./vendor/gsap.min.js"></script>
<script src="./data.js"></script>
<style>
  @font-face { font-family: "Nunito"; font-weight: 400; src: url("./fonts/nunito-latin-400-normal.woff2") format("woff2"); }
  @font-face { font-family: "Nunito"; font-weight: 700; src: url("./fonts/nunito-latin-700-normal.woff2") format("woff2"); }
  @font-face { font-family: "Nunito"; font-weight: 800; src: url("./fonts/nunito-latin-800-normal.woff2") format("woff2"); }
  @font-face { font-family: "Nunito"; font-weight: 900; src: url("./fonts/nunito-latin-900-normal.woff2") format("woff2"); }
  @font-face { font-family: "JetBrains Mono"; font-weight: 400; src: url("./fonts/jetbrains-mono-latin-400-normal.woff2") format("woff2"); }
  @font-face { font-family: "JetBrains Mono"; font-weight: 600; src: url("./fonts/jetbrains-mono-latin-600-normal.woff2") format("woff2"); }

  :root {
    --cream: #FFF7EC; --card: #FFFDF9; --panel: #FCEBD5; --line: #EBD3B8;
    --ink: #3B2A20; --brown: #6B4430; --fur: #B07B53; --fur-dark: #8A5A3B;
    --yuzu: #F7B32B; --yuzu-soft: #FFE6B0; --leaf: #6BAA4B; --leaf-soft: #E3F1D9;
    --blush: #F4A6A0; --slop: #C9483F; --slop-soft: #FBE3DF; --water: #8FD3E8;
  }
  body { margin: 0; }
  #root { position: relative; width: 1920px; height: 1080px; overflow: hidden; background: var(--cream);
          font-family: "Nunito", sans-serif; color: var(--ink); }
  .clip { position: absolute; inset: 0; }
  .r { opacity: 0; visibility: hidden; }  /* revealed by the timeline */
  code, .mono { font-family: "JetBrains Mono", monospace; }

  /* Layers, back to front: warm background · scenes · station strip · Capy · captions.
     The background, the strip and Capy live outside the scenes so they can bridge them. */
  #bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; }
  #blob-a { left: -260px; top: 60px; width: 1400px; height: 1400px; background: radial-gradient(circle, rgba(247,179,43,.22), rgba(247,179,43,0) 64%); }
  #blob-b { left: 980px; top: -560px; width: 1300px; height: 1300px; background: radial-gradient(circle, rgba(244,166,160,.20), rgba(244,166,160,0) 64%); }
  .scene { position: absolute; inset: 0; z-index: 1; opacity: 0; visibility: hidden; transform-origin: 50% 46%; }
  #strip { position: absolute; left: 0; top: 0; width: 1920px; height: 300px; z-index: 3; opacity: 0; visibility: hidden; transform-origin: 50% 30%; }
  #hero { position: absolute; z-index: 4; left: 150px; top: 260px; width: 800px; opacity: 0; visibility: hidden; }
  #hero-bird { position: absolute; left: 26%; top: -4.5%; width: 33%; opacity: 0; visibility: hidden; overflow: visible; }
  #captions { position: absolute; left: 0; right: 0; bottom: 46px; height: 84px; z-index: 50; }
  .cap { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); padding: 14px 32px; border-radius: 24px;
         background: rgba(59,42,32,.9); color: var(--cream); font-size: 38px; font-weight: 800; white-space: nowrap; opacity: 0; visibility: hidden; }

  .headline { position: absolute; left: 140px; top: 96px; margin: 0; font-size: 76px; font-weight: 900; letter-spacing: -1px; }
  .headline.center { left: 0; right: 0; text-align: center; }

  /* the mascot: the timeline drives its expressions, so no CSS animation here */
  svg.capy { display: block; width: 100%; height: auto; overflow: visible; }
  svg.capy.vcapy .capy-eyes-side, svg.capy.vcapy .capy-eyes-happy, svg.capy.vcapy .capy-yuzu { display: inline; opacity: 0; animation: none; }

  /* 1 · title */
  #title-text { position: absolute; left: 990px; top: 360px; }
  #title-word { margin: 0; font-size: 150px; font-weight: 900; letter-spacing: -3px; line-height: 1; }
  #title-sub { margin: 18px 0 0 8px; font-size: 60px; font-weight: 800; color: var(--brown); }
  #title-tag { display: inline-block; margin: 34px 0 0 6px; padding: 12px 26px; border-radius: 999px; background: var(--yuzu-soft);
               color: var(--brown); font-size: 34px; font-weight: 800; }

  /* 2 · problem */
  #pb-slop { color: var(--slop); }
  .slop-grid { position: absolute; left: 140px; top: 270px; width: 1340px; display: grid; grid-template-columns: 1fr 1fr; gap: 36px; }
  .slop-card { background: var(--card); border: 3px solid var(--line); border-radius: 30px; padding: 32px 36px; height: 196px; box-sizing: border-box; }
  .slop-label { font-size: 36px; font-weight: 900; color: var(--slop); margin-bottom: 18px; }
  .slop-card code { display: block; font-size: 28px; color: var(--ink); text-decoration: underline wavy var(--slop) 2px; text-underline-offset: 9px; white-space: pre; }

  /* 3 · how it works */
  .sys { position: absolute; top: 226px; width: 790px; height: 690px; box-sizing: border-box; border-radius: 40px; padding: 40px 46px; background: var(--card); border: 3px solid var(--line); }
  #sys2 { left: 130px; }
  #sys1 { left: 1000px; }
  .sys-badge { display: inline-block; padding: 10px 24px; border-radius: 999px; font-size: 30px; font-weight: 900; }
  #sys2 .sys-badge { background: #E4EEF8; color: #3E6E9E; }
  #sys1 .sys-badge { background: var(--yuzu-soft); color: var(--brown); }
  .sys-title { margin: 20px 0 0; font-size: 42px; font-weight: 900; }
  .model-chip { display: inline-block; margin-top: 16px; padding: 8px 20px; border-radius: 14px; background: var(--panel); font-size: 26px; color: var(--brown); }
  .q { display: grid; grid-template-columns: 150px 1fr; align-items: center; gap: 18px; margin-top: 26px; }
  .q:first-of-type { margin-top: 34px; }
  .q-type { justify-self: start; padding: 8px 16px; border-radius: 12px; background: #EFE3D3; font-size: 24px; font-weight: 800; color: var(--brown); }
  .q-text { font-size: 30px; font-weight: 800; }
  .q-ans { grid-column: 2; display: flex; gap: 12px; align-items: center; margin-top: 10px; font-size: 26px; font-weight: 800; }
  .bar { width: 290px; height: 22px; border-radius: 999px; background: #F1E4D4; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 100%; background: var(--slop); transform-origin: 0 50%; transform: scaleX(0); border-radius: 999px; }
  .opt { padding: 6px 16px; border-radius: 999px; background: #F1E4D4; color: var(--fur-dark); }
  .opt.on { background: var(--yuzu); color: var(--ink); }

  /* station strip (bridges the how and floor scenes) */
  .stations { position: absolute; left: 130px; top: 84px; display: flex; align-items: center; }
  .station { position: relative; width: 230px; height: 92px; box-sizing: border-box; border-radius: 26px; background: var(--card); border: 3px solid var(--line);
             display: grid; place-items: center; font-size: 34px; font-weight: 900; color: var(--fur-dark); }
  .arrow { width: 56px; text-align: center; font-size: 36px; font-weight: 900; color: var(--line); }
  .station .lit { position: absolute; inset: -3px; border-radius: 26px; background: var(--yuzu); display: grid; place-items: center; color: var(--ink); }
  #st-onsen .lit { background: var(--water); }
  #floor-ticket { position: absolute; left: 0; top: 200px; width: 300px; padding: 14px 18px; box-sizing: border-box; border-radius: 18px;
                  background: var(--ink); color: var(--cream); font-size: 24px; font-weight: 800; text-align: center; }

  /* screenshots */
  .shot { position: absolute; border-radius: 24px; overflow: hidden; background: var(--card); box-shadow: 0 30px 70px rgba(59,42,32,.18), 0 0 0 3px var(--line); }
  .shot-bar { position: relative; z-index: 1; height: 40px; background: var(--panel); display: flex; align-items: center; gap: 10px; padding: 0 18px; font-size: 20px; font-weight: 800; color: var(--fur-dark); }
  .shot-bar i { width: 13px; height: 13px; border-radius: 50%; background: #E2C6A6; }
  .shot-bar span { margin-left: 12px; }
  .shot-body { position: relative; overflow: hidden; }
  .shot-body img { display: block; width: 100%; height: 100%; object-fit: cover; transform-origin: 50% 40%; }

  /* 4 · factory floor */
  #floor-shot { left: 340px; top: 290px; width: 1120px; }
  #floor-shot .shot-body { height: 630px; }
  .tags { position: absolute; left: 1500px; top: 380px; display: flex; flex-direction: column; gap: 22px; }
  .tag { padding: 14px 28px; border-radius: 999px; background: var(--leaf-soft); color: #3F7A2C; font-size: 34px; font-weight: 900; }

  /* 5 · the slop catch */
  #catch-shot { left: 100px; top: 200px; width: 900px; }
  #catch-shot .shot-body { height: 506px; }
  #catch-shot .shot-body img { position: absolute; inset: 0; }
  #catch-panel { position: absolute; left: 1060px; top: 200px; width: 760px; }
  #tests-chip { display: inline-block; margin-bottom: 22px; padding: 12px 22px; border-radius: 16px; background: var(--leaf-soft); color: #3F7A2C; font-size: 28px; font-weight: 900; }
  #fails { position: relative; }
  .panel-title { font-size: 30px; font-weight: 900; color: var(--fur-dark); margin-bottom: 18px; }
  .fail { display: grid; grid-template-columns: 40px 1fr auto; align-items: center; gap: 12px; margin-bottom: 12px; padding: 13px 20px;
          border-radius: 20px; background: var(--slop-soft); color: var(--slop); font-size: 27px; font-weight: 800; }
  .fail .x { font-size: 30px; font-weight: 900; }
  .fail .fd { font-family: "JetBrains Mono", monospace; font-size: 24px; }
  #all-pass { position: absolute; left: 0; top: 84px; width: 760px; box-sizing: border-box; padding: 20px 24px; border-radius: 20px; background: var(--leaf-soft);
              color: #3F7A2C; font-size: 32px; font-weight: 900; }
  #catch-stamp { position: absolute; left: 730px; top: 236px; padding: 14px 30px; border-radius: 18px; border: 5px solid var(--leaf); color: #3F7A2C;
                 background: rgba(255,253,249,.94); font-size: 40px; font-weight: 900; transform: rotate(-7deg); }

  /* 6 · stats */
  .stat-grid { position: absolute; left: 100px; top: 280px; width: 1720px; display: grid; grid-template-columns: 1fr 1fr 1.3fr 1fr; gap: 30px; }
  .stat { background: var(--card); border: 3px solid var(--line); border-radius: 36px; padding: 38px 30px; height: 320px; box-sizing: border-box; min-width: 0; }
  .stat .num { font-size: 104px; font-weight: 900; line-height: 1; letter-spacing: -2px; }
  .stat .num small { font-size: 44px; letter-spacing: 0; color: var(--brown); }
  .stat .lbl { margin-top: 22px; font-size: 29px; font-weight: 800; color: var(--brown); white-space: nowrap; }
  .stat .sub { margin-top: 8px; font-size: 23px; font-weight: 700; color: var(--fur); white-space: nowrap; }
  #n-cost { font-size: 88px; }
  #stat-slop .num { color: var(--slop); }
  #stats-foot { position: absolute; left: 0; right: 0; top: 660px; text-align: center; font-size: 32px; font-weight: 800; color: var(--fur-dark); line-height: 1.6; }
  #stats-foot b { color: var(--ink); }

  /* 7 · close */
  #close-text { position: absolute; left: 1000px; top: 300px; }
  .close-line { font-size: 74px; font-weight: 900; line-height: 1.15; }
  #close-2 { color: var(--brown); }
  #close-logo { margin-top: 44px; font-size: 54px; font-weight: 900; color: var(--fur); }
  #close-credits { margin-top: 16px; font-size: 26px; font-weight: 700; color: var(--fur-dark); }
</style>
</head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="{{TOTAL}}" data-width="1920" data-height="1080">
  <div id="stage" class="clip" data-start="0" data-duration="{{TOTAL}}" data-track-index="1">
    <div id="bg"><div class="blob" id="blob-a"></div><div class="blob" id="blob-b"></div></div>

    <section class="scene" id="scene-title">
      <div id="title-text">
        <h1 id="title-word" class="r">CapyWorks</h1>
        <p id="title-sub" class="r">the chillest software factory</p>
        <div id="title-tag" class="r">a software factory with a System 1</div>
      </div>
    </section>

    <section class="scene" id="scene-problem">
      <h2 class="headline"><span id="pb-fast" class="r">Coding agents are fast.</span> <span id="pb-slop" class="r">They also ship slop.</span></h2>
      <div class="slop-grid">
        <div class="slop-card r" id="slop-todo"><div class="slop-label">TODOs everywhere</div><code>// TODO: handle errors later</code></div>
        <div class="slop-card r" id="slop-dead"><div class="slop-label">Dead code</div><code>function legacyTimer() {} // unused</code></div>
        <div class="slop-card r" id="slop-test"><div class="slop-label">Tests that don't test anything</div><code>expect(true).toBe(true);</code></div>
        <div class="slop-card r" id="slop-scope"><div class="slop-label">Changes nobody asked for</div><code>M billing.ts   M .eslintrc</code></div>
      </div>
    </section>

    <section class="scene" id="scene-how">
      <h2 class="headline center r" id="how-title">Thinking, fast and slow.</h2>
      <div class="sys r" id="sys2">
        <span class="sys-badge">System 2 · slow</span>
        <p class="sys-title">An LLM agent writes the code</p>
        <span class="model-chip mono" id="sys2-model"></span>
      </div>
      <div class="sys r" id="sys1">
        <span class="sys-badge">System 1 · fast</span>
        <p class="sys-title">Capy makes every judgment call</p>
        <span class="model-chip mono" id="sys1-model"></span>
        <div class="q r" id="q1"><span class="q-type">yes / no</span><span class="q-text" id="q1-text">Leaves TODOs or placeholders?</span>
          <div class="q-ans"><div class="bar"><i id="q1-bar"></i></div><span class="mono" id="q1-val"></span></div></div>
        <div class="q r" id="q2"><span class="q-type">choice</span><span class="q-text" id="q2-text">Kind of work?</span>
          <div class="q-ans"><span class="opt on mono" id="q2-val">feature</span></div></div>
        <div class="q r" id="q3"><span class="q-type">score</span><span class="q-text" id="q3-text">Risk if shipped unreviewed?</span>
          <div class="q-ans"><span class="opt on mono" id="q3-val">low</span></div></div>
      </div>
    </section>

    <section class="scene" id="scene-floor">
      <div class="shot r" id="floor-shot">
        <div class="shot-bar"><i></i><i></i><i></i><span>CapyWorks · factory floor</span></div>
        <div class="shot-body"><img id="floor-img" src="./assets/screens/floor.png" alt="" /></div>
      </div>
      <div class="tags">
        <span class="tag r" id="tag-prob">probability</span>
        <span class="tag r" id="tag-lat">latency</span>
        <span class="tag r" id="tag-cost">cost</span>
      </div>
    </section>

    <section class="scene" id="scene-catch">
      <h2 class="headline r" id="catch-title" style="top:84px;font-size:64px">Slop bounces. Clean code gets a yuzu.</h2>
      <div class="shot r" id="catch-shot">
        <div class="shot-bar"><i></i><i></i><i></i><span id="catch-bar-text">CapyWorks · Capy Gate</span></div>
        <div class="shot-body"><img id="catch-reject" src="./assets/screens/reject.png" alt="" /><img id="catch-merged" class="r" src="./assets/screens/merged.png" alt="" /></div>
      </div>
      <div id="catch-panel">
        <div id="tests-chip" class="r">✓ Tests passed</div>
        <div id="fails" class="r"><div class="panel-title" id="fails-title">Capy Gate</div><div id="fails-list"></div></div>
        <div id="all-pass" class="r">✓ Every check passed. Merged.</div>
      </div>
      <div id="catch-stamp" class="r">Capy-approved</div>
    </section>

    <section class="scene" id="scene-stats">
      <h2 class="headline center r" id="stats-title">A real run from today</h2>
      <div class="stat-grid">
        <div class="stat r" id="stat-dec"><div class="num" id="n-dec">0</div><div class="lbl">decisions by Capy</div><div class="sub" id="n-dec-sub"></div></div>
        <div class="stat r" id="stat-ms"><div class="num"><span id="n-ms">0</span><small> ms</small></div><div class="lbl">average Jev request</div><div class="sub" id="n-ms-sub"></div></div>
        <div class="stat r" id="stat-cost"><div class="num" id="n-cost"></div><div class="lbl">total Jev cost</div><div class="sub" id="n-cost-sub"></div></div>
        <div class="stat r" id="stat-slop"><div class="num" id="n-slop">0</div><div class="lbl">slop caught</div><div class="sub" id="n-slop-sub"></div></div>
      </div>
      <div id="stats-foot" class="r"></div>
    </section>

    <section class="scene" id="scene-close">
      <div id="close-text">
        <div class="close-line r" id="close-1">Agents do the work.</div>
        <div class="close-line r" id="close-2">Capy makes the calls.</div>
        <div id="close-logo" class="r">CapyWorks</div>
        <div id="close-credits" class="r">TypeSafe Jev · W&amp;B Inference · HeyGen HyperFrames · ElevenLabs</div>
      </div>
    </section>

    <div id="strip">
      <div class="stations">
        <div class="station" id="st-intake">Intake<span class="lit r">Intake</span></div><div class="arrow">→</div>
        <div class="station" id="st-triage">Triage<span class="lit r">Triage</span></div><div class="arrow">→</div>
        <div class="station" id="st-build">Build<span class="lit r">Build</span></div><div class="arrow">→</div>
        <div class="station" id="st-tests">Tests<span class="lit r">Tests</span></div><div class="arrow">→</div>
        <div class="station" id="st-gate">Capy Gate<span class="lit r">Capy Gate</span></div><div class="arrow">→</div>
        <div class="station" id="st-onsen">Onsen<span class="lit r">Onsen</span></div>
      </div>
      <div id="floor-ticket" class="r"></div>
    </div>

    <div id="hero">
      {{CAPY:capy-hero}}
      <svg id="hero-bird" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-label="a coding-agent bird in a hard hat">
        <path d="M22 56 L22 61 M38 56 L38 61" stroke="#E08A1E" stroke-width="3" stroke-linecap="round"/>
        <ellipse cx="30" cy="40" rx="21" ry="18" fill="#6FA8DC"/>
        <ellipse cx="34" cy="45" rx="12.5" ry="10.5" fill="#EAF4FB"/>
        <path d="M14 38 C10 47 18 54 26 49 C22 45 19 41 14 38 Z" fill="#4F8CC4"/>
        <circle cx="40" cy="33" r="3" fill="#3B2A20"/><circle cx="41" cy="32" r="1" fill="#fff"/>
        <path d="M49 35 L58 38.5 L49 42 Z" fill="#F39C12"/>
        <path d="M16 27 A15 13 0 0 1 46 27 Z" fill="#F7B32B"/>
        <rect x="12" y="25.5" width="38" height="5" rx="2.5" fill="#E39A17"/>
      </svg>
    </div>

    <div id="captions"></div>
  </div>

  {{AUDIO}}
</div>

<script>
  const D = window.CAPY;
  const run = D.run ?? {};
  const totals = run.totals ?? {};
  const models = run.models ?? {};
  const story = D.story ?? {};
  const bounced = story.bounced ?? { checks: (run.highlight?.failed ?? []).map((f) => ({ label: f.label, failP: null })) };
  const checks = bounced.checks.slice(0, 5);
  const byId = (id) => document.getElementById(id);
  const scene = Object.fromEntries(D.scenes.map((s) => [s.id, s]));
  const cue = (sceneId, word, fallback = 0.6) => D.cues[sceneId]?.[word] ?? scene[sceneId].voStart + fallback;
  const usd = (v) => (v >= 0.01 ? `$${v.toFixed(2)}` : v > 0 ? `$${Number(v.toPrecision(2))}` : "$0");
  const seconds = (ms) => `${(ms / 1000).toFixed(1)} s`;

  // ---- fill text from the run data -------------------------------------------------------
  byId("sys2-model").textContent = `${models.system2 ?? "LLM"} · W&B Inference`;
  byId("sys1-model").textContent = `${models.system1 ?? "jev"} · TypeSafe`;
  const placeholders = checks.find((c) => c.id === "placeholders");
  const q1Value = typeof placeholders?.value === "number" ? placeholders.value : null;
  byId("q1-val").textContent = q1Value === null ? "" : `P(yes) ${q1Value.toFixed(2)}`;
  const triageOf = (type) => (story.triage ?? []).find((d) => d.type === type);
  if (triageOf("choice")) {
    byId("q2-text").textContent = `${triageOf("choice").label}?`;
    byId("q2-val").textContent = triageOf("choice").display;
  }
  if (triageOf("score")) {
    byId("q3-text").textContent = `${triageOf("score").label}?`;
    byId("q3-val").textContent = triageOf("score").display;
  }
  byId("floor-ticket").textContent = story.ticketId ? `${story.ticketId} · ${story.title}` : (run.tickets?.[0]?.title ?? "New ticket");
  byId("tests-chip").textContent = bounced.tests ? `✓ Tests: ${bounced.tests}` : "✓ Tests passed";
  byId("fails-title").textContent = `Capy Gate · attempt ${bounced.attempt ?? 1}${bounced.latencyMs ? ` · ${bounced.latencyMs} ms` : ""}`;
  for (const [i, check] of checks.entries()) {
    const row = document.createElement("div");
    row.className = "fail r";
    row.id = `fail-${i}`;
    const cells = [["x", "✗"], ["fl", check.label], ["fd", typeof check.failP === "number" ? `P(fail) ${check.failP.toFixed(2)}` : ""]];
    for (const [cls, text] of cells) {
      const span = document.createElement("span");
      span.className = cls;
      span.textContent = text;
      row.appendChild(span);
    }
    byId("fails-list").appendChild(row);
  }
  byId("all-pass").textContent = story.merged
    ? `✓ Attempt ${story.merged.attempt}: all ${story.merged.checks} checks passed in ${story.merged.latencyMs} ms. Merged.`
    : "✓ Every check passed. Merged.";
  byId("catch-bar-text").textContent = story.ticketId ? `CapyWorks · ${story.ticketId} · ${story.title}` : "CapyWorks · Capy Gate";
  byId("stats-title").textContent = D.source === "mock" ? "Sample run (placeholder data)" : "A real run from today";
  byId("n-dec-sub").textContent = totals.jevRequests ? `in ${totals.jevRequests} Jev requests` : "";
  const jevMsTotal = (totals.jevMsAvg ?? 0) * (totals.jevRequests ?? 0);
  byId("n-ms-sub").textContent = jevMsTotal ? `≈ ${seconds(jevMsTotal)} in total` : "";
  byId("n-cost").textContent = usd(totals.jevCostUsd ?? 0);
  byId("n-cost-sub").textContent = totals.decisions && totals.jevCostUsd ? `≈ ${usd(totals.jevCostUsd / totals.decisions)} per decision` : "";
  byId("n-slop-sub").textContent = bounced.tests ? "its tests had passed" : "caught before merge";
  const foot = byId("stats-foot");
  const line1 = document.createElement("div");
  const parts = [
    ["System 2 ", models.system2 ?? "LLM", " spent ", seconds(totals.llmMsTotal ?? 0), " building   ·   "],
    ["System 1 ", models.system1 ?? "jev", " spent ", `≈ ${seconds(jevMsTotal)}`, " judging"],
  ];
  for (const [a, b1, c, b2, d] of parts) {
    const strong1 = document.createElement("b");
    strong1.textContent = b1;
    const strong2 = document.createElement("b");
    strong2.textContent = b2;
    line1.append(a, strong1, c, strong2, d);
  }
  const line2 = document.createElement("div");
  line2.textContent = `${run.tickets?.length ?? 0} tickets · ${totals.merged ?? 0} merged · ${totals.bounced ?? 0} bounced · ${totals.escalated ?? 0} escalated`;
  foot.append(line1, line2);

  // ---- timeline ----------------------------------------------------------------------------
  // Every move eases in and out. Scenes overlap by XFADE seconds at each boundary: the outgoing
  // scene drifts up, shrinks and blurs away while the incoming one rises, settles and sharpens.
  const tl = gsap.timeline({ paused: true });
  const IO = "power2.inOut";
  const XFADE = 1.0;
  const END = D.total;
  const show = (target, at, from = { y: 28 }, duration = 0.6) =>
    tl.fromTo(target, { autoAlpha: 0, ...from }, { autoAlpha: 1, x: 0, y: 0, scale: 1, duration, ease: IO, immediateRender: false }, at);
  const hide = (target, at, to = { y: -24 }, duration = 0.5) =>
    tl.fromTo(target, { autoAlpha: 1, y: 0 }, { autoAlpha: 0, ...to, duration, ease: IO, immediateRender: false }, at);
  const fade = (target, at, from, to, duration = 0.2) =>
    tl.fromTo(target, { opacity: from }, { opacity: to, duration, ease: IO, immediateRender: false }, at);
  const OUT = { autoAlpha: 0, y: -40, scale: 0.97, filter: "blur(8px)" };
  const SETTLED = { autoAlpha: 1, y: 0, scale: 1, filter: "blur(0px)" };
  const IN = { autoAlpha: 0, y: 60, scale: 1.03, filter: "blur(8px)" };

  // the warm background never cuts: two soft lights drift for the whole film
  tl.fromTo("#blob-a", { x: -60, y: -30 }, { x: 140, y: 70, duration: END / 2, ease: "sine.inOut", yoyo: true, repeat: 1, immediateRender: false }, 0);
  tl.fromTo("#blob-b", { x: 60, y: 40 }, { x: -160, y: -20, duration: END / 2, ease: "sine.inOut", yoyo: true, repeat: 1, immediateRender: false }, 0);

  D.scenes.forEach((s, i) => {
    const el = byId(`scene-${s.id}`);
    const first = i === 0;
    const last = i === D.scenes.length - 1;
    const enterAt = first ? 0 : s.start - XFADE / 2;
    const exitAt = last ? END - 1.4 : s.start + s.duration - XFADE / 2;
    tl.fromTo(el, IN, { ...SETTLED, duration: first ? 1.0 : XFADE, ease: IO, immediateRender: false }, enterAt);
    tl.fromTo(el, SETTLED, { ...OUT, duration: last ? 1.4 : XFADE, ease: IO, immediateRender: false }, exitAt);
    const drift = i % 2 ? -1 : 1; // slow camera drift, alternating direction
    tl.fromTo(el, { x: -12 * drift }, { x: 12 * drift, duration: exitAt + XFADE - enterAt, ease: "sine.inOut", immediateRender: false }, enterAt);
  });

  // Capy is one character for the whole film: it glides to its next spot at every boundary
  const spots = {
    title:   { left: 150,  top: 260, width: 800 },
    problem: { left: 1510, top: 560, width: 340 },
    how:     { left: 325,  top: 540, width: 400 },
    floor:   { left: 1530, top: 690, width: 300 },
    catch:   { left: 30,   top: 596, width: 350 },
    stats:   { left: 70,   top: 740, width: 240 },
    close:   { left: 230,  top: 250, width: 680 },
  };
  const GLIDE = XFADE + 0.4;
  tl.fromTo("#hero", { autoAlpha: 0, y: 80 }, { autoAlpha: 1, y: 0, duration: 1.0, ease: IO, immediateRender: false }, 0.15);
  D.scenes.slice(1).forEach((s, i) => {
    tl.fromTo("#hero", { ...spots[D.scenes[i].id] }, { ...spots[s.id], duration: GLIDE, ease: IO, immediateRender: false }, s.start - GLIDE / 2);
  });
  tl.fromTo("#hero", { autoAlpha: 1 }, { autoAlpha: 0, duration: 1.4, ease: IO, immediateRender: false }, END - 1.4);

  const HERO = "#capy-hero";
  let eyes = { open: 1, side: 0, happy: 0 };
  const setEyes = (at, next) => {
    for (const k of ["open", "side", "happy"]) if (eyes[k] !== next[k]) fade(`${HERO} .capy-eyes-${k}`, at, eyes[k], next[k]);
    eyes = next;
  };

  // 1 · title
  const t1 = scene.title.start;
  show("#title-word", t1 + 0.5, { y: 40 }, 0.8);
  show("#title-sub", cue("title", "chillest", 2.4) - 0.3, { y: 24 }, 0.7);
  show("#title-tag", cue("title", "around", 3.6), { y: 16 }, 0.6);
  tl.fromTo(HERO, { y: 0 }, { y: -10, duration: 1.1, ease: "sine.inOut", yoyo: true, repeat: 3, immediateRender: false }, t1 + 1.2);
  tl.fromTo(`${HERO} .capy-eyes-open`, { scaleY: 1 }, { scaleY: 0.1, transformOrigin: "50% 50%", duration: 0.09, ease: IO, yoyo: true, repeat: 1, immediateRender: false }, t1 + 2.9);

  // 2 · problem
  const t2 = scene.problem.start;
  show("#pb-fast", t2 - 0.35, { y: 24 }, 0.8);
  show("#pb-slop", cue("problem", "but", 2.6), { y: 24 });
  setEyes(cue("problem", "messy", 3.4), { open: 0, side: 1, happy: 0 });
  show("#slop-todo", cue("problem", "todos", 4.4), { y: 40, scale: 0.96 });
  show("#slop-dead", cue("problem", "dead", 5.6), { y: 40, scale: 0.96 });
  show("#slop-test", cue("problem", "tests", 6.6), { y: 40, scale: 0.96 });
  show("#slop-scope", cue("problem", "anything", 8.6) + 0.2, { y: 40, scale: 0.96 });

  // 3 · how it works
  const t3 = scene.how.start;
  setEyes(t3, { open: 1, side: 0, happy: 0 });
  show("#how-title", t3 - 0.35, { y: 24 }, 0.8);
  show("#sys2", t3 - 0.1, { y: 40 }, 0.8);
  tl.fromTo("#hero-bird", { y: -140, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.8, ease: "bounce.out", immediateRender: false }, cue("how", "riding", 4) - 0.25);
  show("#sys1", cue("how", "quick", 5.6) - 0.3, { y: 40 }, 0.7);
  const asked = cue("how", "questions", 11);
  show("#q1", asked, { x: 30, y: 0 }, 0.5);
  show("#q2", asked + 0.3, { x: 30, y: 0 }, 0.5);
  show("#q3", asked + 0.6, { x: 30, y: 0 }, 0.5);
  tl.fromTo("#q1-bar", { scaleX: 0 }, { scaleX: q1Value ?? 0, duration: 0.9, ease: IO, immediateRender: false }, cue("how", "sure", 13));
  // the station strip arrives where the headline was, then carries over into the floor scene
  const stripIn = Math.min(cue("how", "blink", scene.how.voSeconds - 0.5) - 0.3, scene.floor.start - XFADE / 2 - 0.4);
  hide("#how-title", stripIn - 0.4, { y: -30 }, 0.6);
  tl.fromTo("#strip", { autoAlpha: 0, y: 30, scale: 0.97 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.9, ease: IO, immediateRender: false }, stripIn);
  tl.fromTo("#hero-bird", { autoAlpha: 1, y: 0 }, { autoAlpha: 0, y: -60, duration: 0.6, ease: IO, immediateRender: false }, scene.floor.start - 0.4);

  // 4 · factory floor
  const t4 = scene.floor.start;
  const stations = ["intake", "triage", "build", "tests", "gate", "onsen"];
  const stationX = (i) => 130 + i * (230 + 56) + 115 - 150; // ticket card's left edge under station i
  const stationCues = [cue("floor", "intake", 2.2), cue("floor", "triage", 2.9), cue("floor", "build", 3.5), cue("floor", "tests", 4.1), cue("floor", "past", 5.6)];
  stationCues.push(stationCues[4] + 0.8);
  tl.fromTo("#floor-ticket", { autoAlpha: 0, x: stationX(0), y: -10 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: IO, immediateRender: false }, t4 + 0.3);
  stations.forEach((id, i) => {
    show(`#st-${id} .lit`, stationCues[i], { scale: 0.92, y: 0 }, 0.4);
    if (i > 0) tl.fromTo("#floor-ticket", { x: stationX(i - 1) }, { x: stationX(i), duration: 0.5, ease: IO, immediateRender: false }, stationCues[i] - 0.25);
  });
  show("#floor-shot", t4 - 0.3, { y: 80 }, 1.0);
  tl.fromTo("#floor-img", { scale: 1, x: 0 }, { scale: 1.08, x: -28, duration: scene.floor.duration + XFADE, ease: "sine.inOut", immediateRender: false }, t4 - 0.3);
  const called = cue("floor", "call", 8.4);
  show("#tag-prob", called, { x: 30, y: 0 }, 0.5);
  show("#tag-lat", called + 0.35, { x: 30, y: 0 }, 0.5);
  show("#tag-cost", called + 0.7, { x: 30, y: 0 }, 0.5);
  tl.fromTo("#strip", SETTLED, { ...OUT, duration: XFADE, ease: IO, immediateRender: false }, t4 + scene.floor.duration - XFADE / 2);

  // 5 · the slop catch
  const t5 = scene.catch.start;
  show("#catch-title", t5 - 0.35, { y: 20 }, 0.8);
  show("#catch-shot", t5 - 0.25, { y: 50 }, 0.9);
  tl.fromTo(["#catch-reject", "#catch-merged"], { scale: 1 }, { scale: 1.07, duration: scene.catch.duration + XFADE / 2, ease: "sine.inOut", immediateRender: false }, t5);
  show("#tests-chip", cue("catch", "tests", 1.6), { y: 16 }, 0.5);
  setEyes(cue("catch", "but", 2.8), { open: 0, side: 1, happy: 0 });
  show("#fails", cue("catch", "caught", 6.2) - 0.2, { y: 16 }, 0.5);
  const listed = cue("catch", "list", 9.4);
  checks.forEach((_, i) => show(`#fail-${i}`, listed + i * 0.22, { x: 40, y: 0 }, 0.45));
  const clean = cue("catch", "clean", 13.5);
  tl.fromTo(["#fails", "#tests-chip"], { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.4, ease: IO, immediateRender: false }, clean - 0.3);
  show("#all-pass", clean, { y: 16 }, 0.5);
  tl.fromTo("#catch-merged", { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.6, ease: IO, immediateRender: false }, clean - 0.2);
  setEyes(clean, { open: 0, side: 0, happy: 1 });
  tl.fromTo(`${HERO} .capy-yuzu`, { opacity: 0, y: -70 }, { opacity: 1, y: 0, duration: 0.75, ease: "bounce.out", immediateRender: false }, cue("catch", "yuzu", 15) - 0.35);
  show("#catch-stamp", cue("catch", "yuzu", 15), { scale: 1.4, y: 0 }, 0.5);

  // 6 · stats
  const t6 = scene.stats.start;
  show("#stats-title", t6 - 0.35, { y: 20 }, 0.8);
  const countUp = (id, value, at) => {
    byId(id).textContent = String(value);
    if (value >= 10) tl.fromTo(byId(id), { innerText: 0 }, { innerText: value, snap: { innerText: 1 }, duration: 1.1, ease: IO, immediateRender: false }, at);
  };
  const decAt = cue("stats", "thirty", 1.8);
  const msAt = cue("stats", "hundred", 3.6);
  const costAt = cue("stats", "cost", 6.4);
  show("#stat-dec", decAt - 0.2, { y: 40 });
  countUp("n-dec", totals.decisions ?? 0, decAt - 0.2);
  show("#stat-ms", msAt - 0.2, { y: 40 });
  countUp("n-ms", Math.round(totals.jevMsAvg ?? 0), msAt - 0.2);
  show("#stat-cost", costAt - 0.2, { y: 40 });
  show("#stat-slop", costAt + 0.4, { y: 40 });
  countUp("n-slop", totals.slopCaught ?? 0, costAt + 0.4);
  show("#stats-foot", costAt + 0.9, { y: 12 });

  // 7 · close
  const t7 = scene.close.start;
  tl.fromTo(HERO, { y: 0 }, { y: -18, duration: 0.35, ease: IO, yoyo: true, repeat: 1, immediateRender: false }, t7 + 0.9);
  show("#close-1", cue("close", "agents", 1.0), { y: 24 });
  show("#close-2", cue("close", "make", 2.2), { y: 24 });
  show("#close-logo", cue("close", "capyworks", 3.6), { y: 16 });
  show("#close-credits", cue("close", "capyworks", 3.6) + 0.4, { y: 10 });

  // captions
  for (const [i, c] of D.captions.entries()) {
    const el = document.createElement("div");
    el.className = "cap";
    el.id = `cap-${i}`;
    el.textContent = c.text;
    byId("captions").appendChild(el);
    tl.fromTo(el, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.15, ease: IO, immediateRender: false }, c.start);
    tl.fromTo(el, { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.15, ease: IO, immediateRender: false }, Math.max(c.start + 0.2, c.end - 0.15));
  }

  tl.set({}, {}, END); // pin the timeline length to the composition duration
  window.__timelines = window.__timelines || {};
  window.__timelines.main = tl;
</script>
</body>
</html>
